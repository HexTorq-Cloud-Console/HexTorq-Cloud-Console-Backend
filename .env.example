NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hextorq_console?schema=public"
JWT_SECRET=replace-with-a-long-random-secret
# 32-byte hex key used to encrypt agent control credentials and client SFTP/database passwords at rest.
AGENT_ENCRYPTION_KEY=replace-with-64-hex-characters
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
LOG_RETENTION_DAYS=30

# Automatic webhook health checks run at this wall-clock hour in this timezone.
WEBHOOK_SCHEDULE_TIMEZONE=Asia/Kolkata
WEBHOOK_SCHEDULE_HOUR=3
WEBHOOK_SCHEDULER_EMAIL=scheduler@hextorq.local
# Maximum time to wait for each scheduled deployment to report completion.
WEBHOOK_HEALTH_DEPLOY_TIMEOUT_MS=1200000
WEBHOOK_HEALTH_POLL_MS=3000

# An agent is considered online when its heartbeat is newer than this window.
AGENT_STALE_THRESHOLD_MS=120000

# Reporting timezone for analytics buckets and previous-window comparisons.
# Falls back to WEBHOOK_SCHEDULE_TIMEZONE, then UTC. Must be a valid IANA zone.
REPORTING_TIMEZONE=Asia/Kolkata

# The sole super-admin account is environment-backed and is not stored in PostgreSQL.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-this-password

# Browser push (Web Push / VAPID) for deployment notifications. Optional: when
# unset, browser push is disabled but the persistent in-app notification history
# still works. Generate a keypair with: npx web-push generate-vapid-keys --json
# Never rotate an existing production keypair (globally-registered subscriptions
# are bound to it).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# NOTE: email/SMTP delivery is intentionally NOT supported. Notifications are
# delivered through browser push and the in-app notification centre only.
