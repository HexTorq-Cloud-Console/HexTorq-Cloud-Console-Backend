NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hextorq_console?schema=public"
JWT_SECRET=replace-with-a-long-random-secret
# 32-byte hex key used to encrypt agent control credentials at rest.
AGENT_ENCRYPTION_KEY=replace-with-64-hex-characters
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
LOG_RETENTION_DAYS=30

# The sole super-admin account is environment-backed and is not stored in PostgreSQL.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-this-password
