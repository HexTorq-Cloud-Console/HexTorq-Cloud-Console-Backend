generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceType {
  PM2
  STATIC_FRONTEND
}

enum DeploymentStatus {
  DEPLOYING
  SUCCESS
  FAILED
  ERROR
}

enum AccessType {
  SFTP
  DATABASE
}

enum WebhookRunSource {
  MANUAL
  SCHEDULED
}

enum WebhookRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum WebhookCheckStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
}

model Client {
  id                          String             @id @default(cuid())
  name                        String
  email                       String             @unique
  googleSubject               String?            @unique
  passwordHash                String
  forcePasswordChange         Boolean            @default(true)
  enabled                     Boolean            @default(true)
  webhookScheduleEnabled      Boolean            @default(false)
  webhookScheduleIntervalDays Int?
  webhookScheduleNextRunAt    DateTime?
  webhookScheduleLastRunAt    DateTime?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  services                    Service[]
  accessEntries               ClientAccess[]
  webhookHealthRuns           WebhookHealthRun[]

  @@index([webhookScheduleEnabled, webhookScheduleNextRunAt])
}

model ServerAgent {
  id              String       @id @default(cuid())
  name            String
  baseUrl         String
  enrollmentToken String       @unique
  apiKeyHash      String?
  apiKeyEncrypted String?
  enabled         Boolean      @default(true)
  lastSeenAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  services        Service[]
  deployments     Deployment[]

  @@index([enabled])
}

model Service {
  id                  String               @id @default(cuid())
  name                String
  slug                String
  type                ServiceType
  repositoryUrl       String
  branch              String               @default("main")
  projectKey          String               @unique
  webhookUrl          String?
  workingDirectory    String
  deployDirectory     String?
  pm2ProcessName      String?
  templateKey         String?
  customCommands      Json?
  webhookSecretHash   String?
  enabled             Boolean              @default(true)
  clientId            String
  agentId             String
  client              Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agent               ServerAgent          @relation(fields: [agentId], references: [id])
  deployments         Deployment[]
  webhookHealthChecks WebhookHealthCheck[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([clientId, slug])
  @@index([clientId])
  @@index([agentId])
}

model Deployment {
  id            String           @id @default(cuid())
  runId         String           @unique
  serviceId     String
  agentId       String
  status        DeploymentStatus @default(DEPLOYING)
  triggerSource String
  deployerEmail String?
  commitHash    String?
  branch        String?
  commitMessage String?
  startedAt     DateTime         @default(now())
  completedAt   DateTime?
  durationMs    Int?
  failureReason String?
  service       Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  agent         ServerAgent      @relation(fields: [agentId], references: [id])
  logs          DeploymentLog[]

  @@index([serviceId, startedAt])
  @@index([startedAt])
}

model DeploymentLog {
  id           String     @id @default(cuid())
  deploymentId String
  timestamp    DateTime   @default(now())
  message      String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId, timestamp])
}

model ClientAccess {
  id                String     @id @default(cuid())
  clientId          String
  type              AccessType
  label             String
  host              String
  port              Int
  username          String
  passwordEncrypted String
  path              String?
  databaseName      String?
  sslMode           String?
  notes             String?
  enabled           Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  client            Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, type])
}

model WebhookHealthRun {
  id                 String               @id @default(cuid())
  clientId           String
  source             WebhookRunSource
  status             WebhookRunStatus     @default(RUNNING)
  requestedBy        String?
  totalServices      Int                  @default(0)
  successfulServices Int                  @default(0)
  failedServices     Int                  @default(0)
  startedAt          DateTime             @default(now())
  completedAt        DateTime?
  client             Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  checks             WebhookHealthCheck[]

  @@index([clientId, startedAt])
  @@index([status])
}

model WebhookHealthCheck {
  id              String             @id @default(cuid())
  runId           String
  serviceId       String
  deploymentRunId String?            @unique
  status          WebhookCheckStatus @default(QUEUED)
  httpStatus      Int?
  message         String?
  createdAt       DateTime           @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  durationMs      Int?
  run             WebhookHealthRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  service         Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([serviceId, createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorEmail   String
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
